# Copy to .env.local and fill in real values. Never commit .env.local.
# See CLIENT-PORTAL-SETUP.md for exactly how to obtain each of these.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# The canonical URL of this deployment. Used for auth redirect URLs (email
# confirmation, password reset) — must match what's configured in Supabase
# Auth's "Redirect URLs" allow-list, or those flows will fail.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (auth + database) — REQUIRED for the client portal to function
# ---------------------------------------------------------------------------
# Project URL and anon (public) key — safe to expose to the browser, RLS is
# what actually protects data, not secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS entirely. SERVER-SIDE ONLY. Never prefix
# with NEXT_PUBLIC_, never import into client-shipped code (lib/supabase/admin.ts
# enforces this at build time via the `server-only` package).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe — Phase 2, LIVE. Checkout won't offer "Card" until STRIPE_SECRET_KEY
# is set (see lib/payments/types.ts isProviderConfigured).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# NOTE: Stripe/PayPal price & plan IDs are NOT env vars — they live on each
# row in the `plans` table (stripe_price_id_monthly, paypal_plan_id_monthly)
# so the server always prices checkout from the database, never from an env
# var or client input. After creating your Stripe Products/Prices, run
# supabase/migrations/0005_payment_provider_ids_template.sql (copy + fill in
# real IDs) in the SQL Editor. See CLIENT-PORTAL-SETUP.md Part 2.

# ---------------------------------------------------------------------------
# PayPal — Phase 2, LIVE. Checkout won't offer "PayPal" until both client ID
# and secret are set.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Wise — Phase 2, LIVE (manual/pending flow — see lib/payments/wise.ts).
# Checkout won't offer "Wise Transfer" until WISE_PAYMENT_LINK is set.
# WISE_API_TOKEN/WISE_PROFILE_ID are optional — reserved for future
# automated reconciliation; today confirmation is manual via /admin/payments.
# ---------------------------------------------------------------------------
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_PAYMENT_LINK=
WISE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email — Phase 5 (not required for this phase)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Lead magnets (free SEO ebook, and any future gated downloads)
# ---------------------------------------------------------------------------
# Any long random string — signs short-lived download tokens so the PDFs
# under private-assets/lead-magnets/ can only be fetched after a real form
# submission. Generate with: openssl rand -hex 32
LEAD_MAGNET_DOWNLOAD_SECRET=

# ---------------------------------------------------------------------------
# Analytics / CRM (existing — unchanged by the client portal build)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
GHL_WEBHOOK_URL=
NEXT_PUBLIC_CLARITY_ID=

# GoHighLevel / LeadConnector live chat widget (components/ChatWidget.tsx).
# Widget ID from the embed snippet, e.g. 6a945debbde3d5bf50ebbb78
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# ---------------------------------------------------------------------------
# Google Reviews (lib/googleReviews.ts / components/GoogleReviewsSection.tsx)
# ---------------------------------------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC_, this key can incur
# Google Cloud billing if exposed. Google Cloud Console > APIs & Services >
# Credentials > Create API Key, then restrict it to "Places API (New)" only.
GOOGLE_PLACES_API_KEY=
# The Place ID for Acendia's Google Business Profile listing — look it up at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
